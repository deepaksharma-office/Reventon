{{ 'subcategory-collection-list.css' | asset_url | stylesheet_tag }}

{% liquid
  assign sub_categories = collection.metafields.custom.sub_categories.value
%}

{% if sub_categories != blank %}
  <section
    id="SubcategoryCollectionList-{{ section.id }}"
    class="subcategory-list color-{{ section.settings.color_scheme }}"
    style="
      --subcategory-section-width: {{ section.settings.container_width }}px;
      --subcategory-desktop-columns: {{ section.settings.desktop_columns }};
      --subcategory-mobile-columns: {{ section.settings.mobile_columns }};
      --subcategory-desktop-gap: {{ section.settings.desktop_gap }}px;
      --subcategory-mobile-gap: {{ section.settings.mobile_gap }}px;
      --subcategory-image-size: {{ section.settings.image_size }}px;
      --subcategory-mobile-image-size: {{ section.settings.mobile_image_size }}px;
      --subcategory-image-border-width: {{ section.settings.image_border_width }}px;
      --subcategory-image-border-color: {{ section.settings.image_border_color }};
      --subcategory-title-size: {{ section.settings.title_size }}px;
      --subcategory-mobile-title-size: {{ section.settings.mobile_title_size }}px;
      --subcategory-title-color: {{ section.settings.title_color }};
      --subcategory-title-weight: {{ section.settings.title_weight }};
      --subcategory-title-spacing: {{ section.settings.title_spacing }}px;
      --subcategory-padding-top: {{ section.settings.padding_top }}px;
      --subcategory-padding-bottom: {{ section.settings.padding_bottom }}px;
      --subcategory-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
      --subcategory-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    "
  >
    <div class="subcategory-list__container">
      {% if section.settings.heading != blank %}
        <div class="subcategory-list__header">
          <h2
            class="subcategory-list__heading"
            style="
              color: {{ section.settings.heading_color }};
              font-size: {{ section.settings.heading_size }}px;
            "
          >
            {{ section.settings.heading }}
          </h2>
        </div>
      {% endif %}

      <div class="subcategory-list__grid">
        {% for sub_collection in sub_categories %}
          {% liquid
            assign collection_image = sub_collection.featured_image

            if collection_image == blank and sub_collection.products.first.featured_image != blank
              assign collection_image = sub_collection.products.first.featured_image
            endif
          %}

          <a
            href="{{ sub_collection.url }}"
            class="subcategory-list__item"
            aria-label="{{ sub_collection.title | escape }}"
          >
            <div class="subcategory-list__image-wrapper">
              {% if collection_image != blank %}
                {{
                  collection_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '160, 240, 320, 480, 640, 800',
                    sizes: '(max-width: 749px) var(--subcategory-mobile-image-size), var(--subcategory-image-size)',
                    class: 'subcategory-list__image',
                    alt: sub_collection.title
                }}
              {% else %}
                <div class="subcategory-list__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'subcategory-list__placeholder-svg' }}
                </div>
              {% endif %}
            </div>

            <span class="subcategory-list__title">
              {{ sub_collection.title }}
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Subcategory list",
  "tag": "section",
  "class": "shopify-section-subcategory-list",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Container width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Desktop columns",
      "default": 6
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Desktop gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 6,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Mobile gap",
      "default": 14
    },
    {
      "type": "header",
      "content": "Collection image"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 80,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Desktop image size",
      "default": 170
    },
    {
      "type": "range",
      "id": "mobile_image_size",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "px",
      "label": "Mobile image size",
      "default": 95
    },
    {
      "type": "range",
      "id": "image_border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Image border width",
      "default": 0
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image border color",
      "default": "#dddddd"
    },
    {
      "type": "header",
      "content": "Collection title"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Desktop title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile title size",
      "default": 13
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Space above title",
      "default": 12
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Subcategory list"
    }
  ]
}
{% endschema %}