{%- assign gallery_id = 'EventGallery-' | append: section.id -%}
{{ 'event-category-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'event-category-gallery.js' | asset_url }}" defer="defer"></script>

<section id="{{ gallery_id }}" class="event-gallery" data-event-gallery-section style="--eg-desktop-columns: {{ section.settings.desktop_columns }}; --eg-mobile-columns: {{ section.settings.mobile_columns }}; --eg-gap: {{ section.settings.grid_gap }}px; --eg-radius: {{ section.settings.card_radius }}px; --eg-background: {{ section.settings.background_color }}; --eg-text: {{ section.settings.text_color }}; --eg-accent: {{ section.settings.accent_color }}; --eg-padding-top: {{ section.settings.padding_top }}px; --eg-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="event-gallery__container">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="event-gallery__header">
        {% if section.settings.heading != blank %}<h2 class="event-gallery__heading">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.description != blank %}<div class="event-gallery__description">{{ section.settings.description }}</div>{% endif %}
      </div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <div class="event-gallery__tabs-wrap">
        <div class="event-gallery__tabs" role="tablist" aria-label="Event gallery categories">
          {% for block in section.blocks %}
            {%- assign tab_label = block.settings.label | default: 'Gallery' -%}
            <button type="button" id="{{ gallery_id }}-tab-{{ block.id }}" class="event-gallery__tab{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="{{ gallery_id }}-panel-{{ block.id }}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-gallery-tab data-panel-id="{{ gallery_id }}-panel-{{ block.id }}">{{ tab_label | escape }}</button>
          {% endfor %}
        </div>
      </div>
      {% for block in section.blocks %}
        {%- assign tab_label = block.settings.label | default: 'Gallery' -%}
        <div id="{{ gallery_id }}-panel-{{ block.id }}" class="event-gallery__panel" role="tabpanel" aria-labelledby="{{ gallery_id }}-tab-{{ block.id }}" data-gallery-panel {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="event-gallery__grid">
            {% for image_number in (1..50) %}
              {%- liquid
                assign image_id = 'image_' | append: image_number
                assign gallery_image = block.settings[image_id]
                assign image_alt = gallery_image.alt | default: tab_label
              -%}
              {% if gallery_image != blank %}
                {%- capture image_sizes -%}(min-width: 990px) calc((100vw - 40px) / {{ section.settings.desktop_columns }}), calc((100vw - 32px) / {{ section.settings.mobile_columns }}){%- endcapture -%}
                <button type="button" class="event-gallery__card event-gallery__card--{{ section.settings.image_ratio }}" data-gallery-open data-image-url="{{ gallery_image | image_url | escape }}" data-image-alt="{{ image_alt | escape }}" aria-label="Open {{ image_alt | escape }}">
                  <span class="event-gallery__media">{{ gallery_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 1000, 1200, 1500, 1800', sizes: image_sizes, class: 'event-gallery__image', alt: image_alt }}</span>
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  <dialog class="event-gallery__modal" data-gallery-modal aria-label="Image viewer">
    <button type="button" class="event-gallery__modal-close" data-gallery-close aria-label="Close image viewer">&times;</button>
    <div class="event-gallery__modal-media"><img class="event-gallery__modal-image" data-gallery-modal-image src="" alt="" width="1" height="1"></div>
  </dialog>
</section>

{% schema %}
{
  "name": "Event category gallery",
  "tag": "section",
  "class": "section-event-category-gallery",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Event Gallery" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Explore our work from previous events.</p>" },
    { "type": "header", "content": "Gallery layout" },
    { "type": "range", "id": "desktop_columns", "label": "Images per row - desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "mobile_columns", "label": "Images per row - mobile", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "grid_gap", "label": "Image gap", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "select", "id": "image_ratio", "label": "Image format", "options": [{ "value": "auto", "label": "Auto" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }], "default": "auto" },
    { "type": "range", "id": "card_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F8F6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#161616" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1F6A43" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
